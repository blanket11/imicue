{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "customConditions": [
      "imicue-source"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "examples/server-node/**/*.ts",
    "site/**/*.ts",
    "*.config.ts",
    "tests/**/*.tsx"
  ]
}
